\section{}
(a) find the gradient of $f$, (b) Evaluate the gradient at the point P, and (c) Find the rate of change of $f$ at P
in the direction of the vector $\vec{u}$.
\newline{}
$f(x,y,z) = x^2yz-xyz^3$, $P(2,-1,1)$, $\vec{u} = \langle 0 , \frac{4}{5} , -\frac{3}{5} \rangle$
\begin{enumerate}
  \item[\textbf{a)}] $\frac{\partial f}{\partial x} = 2xyz - yz^3$, $\frac{\partial f}{\partial y} = x^2z-xz^3$, $\frac{\partial f}{\partial z} = x^2y - 3xyz^2 
  \newline{}
  \to \nabla{f} = \langle 2xyz-yz^3 , x^2z - xz^3 , x^2y - 3xyz^2 \rangle$
\item[\textbf{b)}] $\nabla{f}(2,-1,1) = \langle 2(2)(-1)(1) - (-1)(1)^3 , (2)^2(1) - (2)(1)^3 , (2)^2(-1) - 3(2)(-1)(1)^2 \rangle = \langle -3 , 2 , 2 \rangle$
\item[\textbf{c)}] $D_{\vec{u}}f(2,-1,1) = \nabla{f} (2,-1,1) \cdot \vec{u} = \frac{2}{5}$  
\end{enumerate}

