% Question 1
\section{}
Find the directional derivative of $f$ at the given point in the direction indicated by the angle $\theta$.
\begin{enumerate}
  \item[\textbf{a)}] $f(x,y)=xy^3-x^2$,   $(1,2)$,  $\theta=\frac{\pi}{3}$
    \newline{}
    \newline{}
    We find the unit vector $\vec{u}$ on the unit circle to be $\langle \cos(\frac{\pi}{3}), \sin(\frac{\pi}{3})\rangle$
    = $\langle \frac{1}{2}, \frac{\sqrt{3}}{2} \rangle$
    Then, we can find $\frac{\partial f}{\partial x} = y^3 - 2x$, and $\frac{\partial f}{\partial y} = 2xy^2$,
    so $\nabla{f}  = \langle y^3 - 2x, 3xy^2 \rangle$
    $\nabla{f(1,2)}=\langle 2^3 - 2(1), 3(1)(2)^2 \rangle = \langle 6, 12 \rangle $
    \newline{}
    $D_{\vec{u}}f = \nabla{f} \cdot \vec{u} =  \langle 6 , 12 \rangle \cdot \langle\frac{1}{2}, \frac{\sqrt{3}}{2} \rangle = 3 + 6\sqrt{3}$ 
  \item[\textbf{b)}] $f(x,y)=y\cos{xy}$, $(0,1)$, $\theta=\frac{\pi}{4}$
    \newline{}
    \newline{}
    $\vec{u} = \langle \cos(\frac{\pi}{4}) , \sin(\frac{\pi}{4}) \rangle = \langle \frac{\sqrt{2}}{2} , \frac{\sqrt{ 2}}{2} \rangle$
    \newline{}
    $\frac{\partial f}{\partial x} = -y^2\sin(xy)$, $\frac{\partial f}{\partial y} = 1(\cos(xy)) - y(x\sin(xy)) = \cos(xy) - xy\sin(xy)$
    \newline{}
    $\nabla{f}(0,1) = \langle -1^2\sin(0*1) , \cos(0*1) - 0 \rangle = \langle 0 , 1 \rangle$
    \newline{}
    $D_{\vec{u}}f = \nabla{f} \cdot \vec{u} = \langle 0 , 1 \rangle \cdot \langle \frac{\sqrt{ 2}}{2} , \frac{\sqrt{ 2}}{2} \rangle = \frac{\sqrt{ 2}}{2}$  
\end{enumerate}

% Question 2
\section{}
(a) find the gradient of $f$, (b) Evaluate the gradient at the point P, and (c) Find the rate of change of $f$ at P
in the direction of the vector $\vec{u}$.
\newline{}
$f(x,y) = x/y$, $P(2,1)$, $\vec{u} = \frac{3}{5}\hat{\imath} + \frac{4}{5}\hat{\jmath}$
\begin{enumerate}
  \item[\textbf{a)}] $\frac{\partial f}{\partial x} = \frac{1}{y}$, $\frac{\partial f }{\partial y} = -\frac{x}{y^2} \to \nabla{f} = \langle \frac{1}{y} , -\frac{x}{y^2} \rangle$
  \item[\textbf{b)}] $\nabla{f}(2,1) = \langle \frac{1}{1} , -\frac{2}{1^2} \rangle = \langle 1 , -2 \rangle$
  \item[\textbf{c)}] $D_{\vec{u}}f(2,1) = \nabla{f}(2,1) \cdot \vec{u} = \langle 1 , -2 \rangle \cdot \langle \frac{3}{5} , \frac{4}{5} \rangle = \frac{3}{5} - \frac{8}{5} = -1$ 
\end{enumerate}

