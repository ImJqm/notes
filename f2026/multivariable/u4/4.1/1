\section{}
find the directional derivative of the function at the given point in the direction of the vector $\vec{v}$
\newline{}
$f(x,y) = e^x \sin y$, $(0, \frac{\pi}{3})$, $\vec{v} = \langle -6 , 8 \rangle$
\newline{}
$\frac{\partial f}{\partial x} = \sin(y) e^x$, $\frac{\partial f }{\partial y} = e^x \cos y \to \nabla{f} (0 , \frac{\pi}{3}) = \langle \frac{\sqrt{ 3}}{2} , \frac{1}{2} \rangle$
\newline{}
$\vec{u} = \hat{\vec{v}} \to |\vec{v}| = \sqrt{ (-6)^2 + (8)^2 } = 10 \to \vec{u} = \langle -\frac{3}{5} , \frac{4}{5} \rangle$
\newline{}
$D_{\vec{u}}f(0, \frac{\pi}{3}) =  \nabla{f}(0, \frac{\pi}{3}) \cdot \vec{u} = \langle \frac{\sqrt{ 3}}{2} , \frac{1}{2} \rangle \cdot \langle - \frac{3}{5} , \frac{4}{5} \rangle =  \frac{4 - \sqrt{ 3}}{10}$

